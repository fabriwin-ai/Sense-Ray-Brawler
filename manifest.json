{
  "manifest_version": 3,
  "name": "SENSE RAY-Brawler",
  "short_name": "SENSE RAY",
  "description": "Webcam motion gaze cursor — affine calibration · frame histogram exposure · LUT verification · configurable MNIST reticle",
  "version": "2.0.0",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ray-presets.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SENSE RAY — Gaze Tracker"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["overlay/overlay.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
